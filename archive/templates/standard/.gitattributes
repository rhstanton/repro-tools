# Git attributes for consistent line endings across platforms
# See: https://git-scm.com/docs/gitattributes

# Auto-detect text files and normalize to LF
* text=auto eol=lf

# Force LF for shell scripts (required for Linux/macOS execution)
*.sh text eol=lf
*.bash text eol=lf

# Force LF for Python scripts
*.py text eol=lf

# Force LF for Julia scripts
*.jl text eol=lf

# Force LF for Stata scripts
*.do text eol=lf
*.ado text eol=lf

# Force LF for Makefiles (tabs required, must be LF)
Makefile text eol=lf
*.mk text eol=lf

# Force LF for YAML/TOML configuration
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Force LF for data files
*.csv text eol=lf
*.tsv text eol=lf
*.txt text eol=lf

# Markdown and documentation
*.md text eol=lf

# Binary files (do not modify)
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pkl binary
*.rds binary
*.dta binary
*.sav binary
